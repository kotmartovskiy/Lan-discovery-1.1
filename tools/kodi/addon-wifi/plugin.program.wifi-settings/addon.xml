<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.wifi-settings" name="Wi-Fi Settings" version="1.0.0" provider-name="lan-discovery">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="ru">Настройки Wi-Fi сети</summary>
    <description lang="ru">Выбор Wi-Fi сети и ввод пароля через NetworkManager (nmcli)</description>
    <platform>linux</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
