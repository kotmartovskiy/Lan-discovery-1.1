<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.retro-games" name="Ретроигры" version="1.0.0" provider-name="lan-discovery">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="ru">Ретроигры через RetroArch</summary>
    <description lang="ru">Запуск эмуляторов (NES, SNES, GB, GBA, Genesis, PSX) через RetroArch; после выхода возвращается Kodi</description>
    <platform>linux</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
